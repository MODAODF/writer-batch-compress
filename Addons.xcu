<?xml version='1.0' encoding='UTF-8'?>
<oor:component-data 
 xmlns:oor="http://openoffice.org/2001/registry"
 xmlns:xs="http://www.w3.org/2001/XMLSchema"
 oor:name="Addons"
 oor:package="org.openoffice.Office">
    <node oor:name="AddonUI">
        <node oor:name="OfficeToolbarMerging">
            <node oor:name="org.ossii.WriterBatchCompress.OfficeToolbarMerging" oor:op="replace">
                <node oor:name="WBC001" oor:op="replace">
                    <prop oor:name="MergeToolBar" oor:type="xs:string">
                        <value>standardbar</value>
                    </prop>
                    <prop oor:name="MergePoint">
                        <value>.uno:InsertObjectChart</value>
                    </prop>
                    <prop oor:name="MergeCommand">
                        <value>AddBefore</value>
                    </prop>
                    <prop oor:name="MergeFallback">
                        <value>AddFirst</value>
                    </prop>
                    <prop oor:name="MergeContext" oor:type="xs:string">
                        <value>com.sun.star.text.TextDocument</value>
                    </prop>
                    <node oor:name="ToolBarItems">
                        <node oor:name="WBC002" oor:op="replace">
                            <prop oor:name="URL" oor:type="xs:string">
                                <value>vnd.sun.star.script:PixCompress.PixCompress.Main?language=Basic&amp;location=application</value>
                            </prop>
                            <prop oor:name="Title" oor:type="xs:string">
                                <value xml:lang="en">Compress pictures</value>
                                <value xml:lang="zh-TW">批次壓縮圖片</value>
                            </prop>
                            <prop oor:name="Target" oor:type="xs:string">
                                <value>_self</value>
                            </prop>
                            <prop oor:name="Context" oor:type="xs:string">
                                <value>com.sun.star.text.TextDocument</value>
                            </prop>
                        </node> <!-- WBC002 -->
                    </node> <!-- ToolBarItems -->
                </node> <!-- WBC001 -->
            </node> <!-- org.ossii.WriterBatchCompress.OfficeToolbarMerging -->
        </node> <!-- OfficeToolbarMerging -->
        <node oor:name="OfficeMenuBarMerging">
            <node oor:name="org.ossii.WriterBatchCompress.OfficeMenuBarMerging" oor:op="replace">
                <node oor:name="WBC003" oor:op="replace">
                    <prop oor:name="MergePoint">
                        <value>.uno:InsertMenu\.uno:InsertGraphic</value>
                    </prop>
                    <prop oor:name="MergeCommand">
                        <value>AddAfter</value>
                    </prop>
                    <prop oor:name="MergeFallback">
                        <value>AddPath</value>
                    </prop>
                    <prop oor:name="MergeContext" oor:type="xs:string">
                        <value>com.sun.star.text.TextDocument</value>
                    </prop>
                    <node oor:name="MenuItems">
                        <node oor:name="WBC004" oor:op="replace">
                            <prop oor:name="URL" oor:type="xs:string">
                                <value>vnd.sun.star.script:PixCompress.PixCompress.Main?language=Basic&amp;location=application</value>
                            </prop>
                            <prop oor:name="Title" oor:type="xs:string">
                                <value xml:lang="en">Compress all pictures...</value>
                                <value xml:lang="zh-tw">壓縮所有圖片...</value>
                            </prop>
                            <prop oor:name="Target" oor:type="xs:string">
                                <value>_self</value>
                            </prop>
                        </node> <!-- WBC004 -->
                    </node> <!-- MenuItems -->
                </node> <!-- WBC003 -->
            </node> <!-- org.ossii.WriterBatchCompress.OfficeMenuBarMerging -->
        </node> <!-- OfficeMenuBarMerging -->
        <node oor:name="OfficeNotebookBar">
            <node oor:name="org.ossii.WriterBatchCompress.OfficeNotebookBar" oor:op="replace">
                <node oor:name="WBC005" oor:op="replace">
                    <prop oor:name="Context" oor:type="xs:string">
                        <value>com.sun.star.text.TextDocument</value>
                    </prop>
                    <prop oor:name="URL">
                        <value>vnd.sun.star.script:PixCompress.PixCompress.Main?language=Basic&amp;location=application</value>
                    </prop>
                    <prop oor:name="Title">
                        <value xml:lang="en">Compress all pictures...</value>
                        <value xml:lang="zh-tw">壓縮所有圖片...</value>
                    </prop>
                    <prop oor:name="Target">
                        <value>_self</value>
                    </prop>
                </node> <!-- ONB001 -->
           </node> <!-- ossii.OfficeNotebookBar -->
        </node> <!-- OfficeNotebookBar -->
        <node oor:name="Images">
            <node oor:name="org.ossii.WriterBatchCompress.WBC.N001" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>vnd.sun.star.script:PixCompress.PixCompress.Main?language=Basic&amp;location=application</value>
                </prop>
                <node oor:name="UserDefinedImages">
                    <prop oor:name="ImageSmallURL" oor:type="xs:string">
                        <value>%origin%/icons/image1_16.bmp</value>
                    </prop>
                </node> <!-- UserDefinedImages -->
            </node> <!-- org.ossii.WriterBatchCompress.WBC.N001 -->
        </node> <!-- Images -->
    </node> <!-- AddonUI -->
</oor:component-data>
